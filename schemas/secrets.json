{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wharfy.io/schemas/v1/secrets.json",
  "title": "wharfy secrets output (v1)",
  "description": "`wharfy secrets --json` の出力。channels: から一意に決まる資格情報(env)と、GitHub Actions での渡し方(permissions / env / 注記)を data に返す。wharfy は資格情報を env からしか取らないので、手元と CI は同じ 1 枚の表で語れる(D-12)。",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "https://wharfy.io/schemas/v1/common.json#/$defs/schemaVersion"
    },
    "command": {
      "const": "secrets"
    },
    "ok": {
      "type": "boolean"
    },
    "message": {
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/secrets"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "https://wharfy.io/schemas/v1/common.json#/$defs/warning"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "https://wharfy.io/schemas/v1/common.json#/$defs/problem"
      }
    },
    "next": {
      "$ref": "https://wharfy.io/schemas/v1/common.json#/$defs/next"
    }
  },
  "required": [
    "schema_version",
    "command",
    "ok",
    "data",
    "next"
  ],
  "additionalProperties": false,
  "$defs": {
    "secrets": {
      "type": "object",
      "properties": {
        "credentials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/credential"
          }
        },
        "actions": {
          "$ref": "#/$defs/actions"
        }
      },
      "required": [
        "credentials",
        "actions"
      ],
      "additionalProperties": false
    },
    "credential": {
      "description": "wharfy が env から読む資格情報 1 つと、それを要るチャネル。",
      "type": "object",
      "properties": {
        "env": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string"
        },
        "channels": {
          "description": "この資格情報を要るチャネル(sign を含む)。",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "met": {
          "description": "いま実行している環境で解決できるか(env、fury は keychain も)。",
          "type": "boolean"
        },
        "source": {
          "description": "CI での出どころ。actions_builtin は Actions が自前で配る(登録不要)。repo_secret は利用者が登録する。",
          "enum": [
            "actions_builtin",
            "repo_secret"
          ]
        },
        "register": {
          "description": "登録コマンド(repo_secret のときだけ)。",
          "type": "string"
        }
      },
      "required": [
        "env",
        "purpose",
        "channels",
        "met",
        "source"
      ],
      "additionalProperties": false
    },
    "actions": {
      "description": "GitHub Actions の workflow に貼る断片。",
      "type": "object",
      "properties": {
        "permissions": {
          "description": "workflow に要る permissions: の行。",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "env": {
          "description": "env 名 → workflow で渡す式(${{ secrets.… }})。",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "notes": {
          "description": "前提の注記(組み込みトークンでは開かない書き先、macos ランナーが要る等)。",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
